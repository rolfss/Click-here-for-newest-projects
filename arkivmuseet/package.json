{
  "name": "arkivmuseet",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm content && vite --host 127.0.0.1 --port 5196 --strictPort",
    "build": "pnpm content && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4196 --strictPort",
    "test": "pnpm content && node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:investigation": "node scripts/verify-investigation.mjs",
    "test:visit-ui": "node scripts/verify-visit-ui.mjs && node scripts/verify-leadership.mjs",
    "test:leadership": "node scripts/verify-leadership.mjs",
    "content": "node scripts/validate-cases.mjs && node --experimental-strip-types scripts/make-text-version.mjs && node --experimental-strip-types scripts/make-leader-version.mjs && node scripts/make-investigation-text.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.20.0",
    "@theatre/core": "0.7.2",
    "postprocessing": "6.39.5",
    "three": "0.185.1",
    "three-mesh-bvh": "0.9.15",
    "xstate": "5.33.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.0",
    "@playwright/test": "1.63.0",
    "@theatre/studio": "0.7.2",
    "@types/three": "0.183.1",
    "spectorjs": "0.9.30",
    "three-bvh-csg": "0.0.18",
    "tweakpane": "4.0.5",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
