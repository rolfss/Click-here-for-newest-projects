{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "quizpa",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quizpa",
      "migrations_dir": "migrations"
    }
  ]
}
